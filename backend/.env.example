# ─────────────────────────────────────────────
# CareFlow Hospital Management — Environment Variables
# Copy this file to .env and fill in the values
# ─────────────────────────────────────────────

# MongoDB Atlas connection string (required in production)
# Get it from: https://cloud.mongodb.com → Connect → Drivers
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/careflow?retryWrites=true&w=majority

# Server port (Render sets this automatically)
PORT=5000

# JWT secret key (use a long random string in production)
JWT_SECRET=your-super-secret-jwt-key-change-this

# Environment
NODE_ENV=development
